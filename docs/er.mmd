    TABLA_AUDITADA ||--o{ COLUMNA_AUDITADA : "contiene"
    COLUMNA_AUDITADA ||--o{ CONFIGURACION : "se vigila en"
    TIPO_EVENTO ||--o{ CONFIGURACION : "clasifica"
    CONFIGURACION ||--o{ BITACORA : "origina"
    USUARIO_AUDITADO ||--o{ BITACORA : "responsable de"
